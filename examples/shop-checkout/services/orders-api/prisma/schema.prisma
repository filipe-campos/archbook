datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String      @id
  cartId          String      @unique
  customerEmail   String
  total           Int
  currency        String      @default("usd")
  status          OrderStatus
  paymentIntentId String?
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  items           OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  sku       String
  quantity  Int
  unitPrice Int
  order     Order  @relation(fields: [orderId], references: [id])
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  FAILED
}

/// Written in the same transaction as the state change it announces.
model OutboxEvent {
  id          BigInt    @id @default(autoincrement())
  type        String
  aggregateId String
  payload     Json
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([publishedAt, id])
}

/// One row per Stripe event id: a redelivered webhook hits the primary key and is skipped.
model ProcessedStripeEvent {
  id          String   @id
  processedAt DateTime @default(now())
}
