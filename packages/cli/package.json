{
  "name": "archbook",
  "version": "0.1.0",
  "description": "Living, replayable architecture docs, generated by Claude Code.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archbook": "dist/index.js"
  },
  "files": [
    "dist",
    "viewer",
    "plugin",
    "schema"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "architecture",
    "documentation",
    "diagram",
    "claude-code",
    "react-flow",
    "c4"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/archbook/archbook.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/archbook/archbook#readme",
  "scripts": {
    "build": "tsup && node scripts/copy-assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "tar": "^7.5.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@archbook/schema": "workspace:*",
    "@archbook/viewer": "workspace:*",
    "tsup": "^9.0.0"
  }
}
