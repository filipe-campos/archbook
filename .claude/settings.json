{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test:coverage)",
      "Bash(pnpm test:e2e)",
      "Bash(pnpm --filter * typecheck)",
      "Bash(pnpm --filter * test)",
      "Bash(pnpm --filter * test:coverage)",
      "Bash(pnpm --filter * exec vitest run *)",
      "Bash(node packages/cli/dist/index.js validate *)",
      "Bash(node packages/cli/dist/index.js format --check *)",
      "Bash(claude plugin validate *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  }
}
